{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anno-1800-expert-buddy.local/docs/harbor-live.schema.json",
  "title": "harbor-live-v1",
  "description": "JSON that the Windows watcher writes to Documents/Anno 1800/harbor-live.json. Signal lane only: no inject, no .a7s in the browser. Field policy: docs/harbor-live-fields.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source", "updatedAt", "game", "quests"],
  "properties": {
    "schema": { "const": "harbor-live-v1" },
    "source": { "type": "string", "enum": ["telemetry", "save", "file"] },
    "updatedAt": { "type": "string", "format": "date-time" },
    "savedAt": { "type": "string", "format": "date-time" },
    "game": { "const": "anno-1800" },
    "sessionName": { "type": "string", "minLength": 1, "maxLength": 200 },
    "islandName": { "type": "string", "minLength": 1, "maxLength": 200 },
    "campaignId": { "type": "string", "minLength": 1, "maxLength": 120 },
    "playerId": { "type": "integer" },
    "snapshotId": { "type": "string", "minLength": 1, "maxLength": 120 },
    "simTime": { "type": "integer" },
    "economy": { "$ref": "#/$defs/economy" },
    "reader": { "$ref": "#/$defs/reader" },
    "coverage": { "$ref": "#/$defs/coverage" },
    "islandSnapshots": {
      "type": "array",
      "maxItems": 40,
      "items": { "$ref": "#/$defs/islandSnapshot" }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "type": "string", "enum": ["documents-save", "ubisoft-cloud", "native", "manual"] },
        "fileName": { "type": "string", "minLength": 1, "maxLength": 160 },
        "buildingKinds": { "type": "integer", "minimum": 0 },
        "buildingTotal": { "type": "integer", "minimum": 0 },
        "goodsKinds": { "type": "integer", "minimum": 0 },
        "routeCount": { "type": "integer", "minimum": 0 },
        "islandCount": { "type": "integer", "minimum": 0 },
        "questCount": { "type": "integer", "minimum": 0 },
        "native": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "view", "observedAt"],
          "properties": {
            "provider": { "const": "ux-enhancer-ocr" },
            "view": { "type": "string", "enum": ["production", "finance", "population", "unknown"] },
            "observedAt": { "type": "string", "format": "date-time" },
            "islandName": { "type": "string", "minLength": 1, "maxLength": 200 },
            "serverVersion": { "type": "string", "minLength": 1, "maxLength": 40 },
            "islandRef": { "$ref": "#/$defs/islandRef" }
          }
        },
        "nativeProbe": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "state", "lastProbeAt"],
          "properties": {
            "provider": { "const": "ux-enhancer-ocr" },
            "state": { "type": "string", "enum": ["reachable", "unreachable", "invalid_response"] },
            "lastProbeAt": { "type": "string", "format": "date-time" },
            "lastSuccessAt": { "type": "string", "format": "date-time" },
            "result": { "type": "string", "enum": ["observation", "no_observation", "no_window"] },
            "reason": { "type": "string", "enum": ["timeout", "connection_refused", "bad_payload"] }
          }
        }
      }
    },
    "quests": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "state": {
            "type": "string",
            "enum": ["active", "ready", "done", "failed", "expired"]
          },
          "objective": { "type": "string", "minLength": 1, "maxLength": 400 },
          "instanceId": { "type": "string", "minLength": 1, "maxLength": 80 },
          "guid": { "type": "integer", "exclusiveMinimum": 0 },
          "type": {
            "type": "string",
            "enum": ["story", "delivery", "errand", "timer", "unknown"]
          },
          "progress": { "$ref": "#/$defs/questProgress" },
          "timer": { "$ref": "#/$defs/questTimer" },
          "objectives": {
            "type": "array",
            "maxItems": 8,
            "items": { "$ref": "#/$defs/questObjective" }
          }
        }
      }
    },
    "pulseHint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coins", "houses"],
      "properties": {
        "coins": { "type": "string", "enum": ["unknown", "up", "down"] },
        "houses": { "type": "string", "enum": ["unknown", "ok", "yellow", "empty"] }
      }
    },
    "workforce": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "farmers": { "const": true },
        "workers": { "const": true },
        "artisans": { "const": true },
        "engineers": { "const": true }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "buildings": { "$ref": "#/$defs/buildingHits" },
        "people": { "$ref": "#/$defs/namedHits" },
        "chains": { "$ref": "#/$defs/namedHits" },
        "islands": { "$ref": "#/$defs/namedHits" },
        "hints": {
          "type": "array",
          "maxItems": 30,
          "items": { "type": "string", "minLength": 1, "maxLength": 40 }
        },
        "goods": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "amount"],
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 48 },
              "name": { "type": "string", "minLength": 1, "maxLength": 80 },
              "amount": { "type": "integer" }
            }
          }
        },
        "goodsChanges": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "previousAmount",
              "amount",
              "delta",
              "previousSavedAt"
            ],
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 48 },
              "name": { "type": "string", "minLength": 1, "maxLength": 80 },
              "previousAmount": { "type": "integer" },
              "amount": { "type": "integer" },
              "delta": { "type": "integer" },
              "previousSavedAt": { "type": "string", "format": "date-time" }
            }
          }
        },
        "fleet": {
          "type": "array",
          "maxItems": 80,
          "items": { "$ref": "#/$defs/fleetShip" }
        },
        "routes": {
          "type": "array",
          "maxItems": 80,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "shipCount", "stops"],
            "properties": {
              "id": { "type": "integer" },
              "name": { "type": "string", "minLength": 1, "maxLength": 120 },
              "ownerId": { "type": "integer" },
              "shipCount": { "type": "integer", "minimum": 0 },
              "stops": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["goods"],
                  "properties": {
                    "areaId": { "type": "integer" },
                    "goods": {
                      "type": "array",
                      "maxItems": 20,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["guid", "amount"],
                        "properties": {
                          "guid": { "type": "integer" },
                          "id": { "type": "string", "minLength": 1, "maxLength": 48 },
                          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
                          "amount": { "type": "integer" },
                          "isLoading": { "type": "boolean" }
                        }
                      }
                    }
                  }
                }
              },
              "ships": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name"],
                  "properties": {
                    "name": { "type": "string", "minLength": 1, "maxLength": 80 }
                  }
                }
              },
              "delivery": {
                "type": "object",
                "additionalProperties": false,
                "required": ["visitCount", "lastExecutionTime", "goods"],
                "properties": {
                  "visitCount": { "type": "integer", "minimum": 1 },
                  "lastExecutionTime": { "type": "integer" },
                  "intervalMsMedian": { "type": "integer", "minimum": 1 },
                  "goods": {
                    "type": "array",
                    "maxItems": 20,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["guid", "visitCount", "medianAbsAmount", "lastAmount"],
                      "properties": {
                        "guid": { "type": "integer" },
                        "id": { "type": "string", "minLength": 1, "maxLength": 48 },
                        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
                        "visitCount": { "type": "integer", "minimum": 0 },
                        "medianAbsAmount": { "type": "integer", "minimum": 0 },
                        "lastAmount": { "type": "integer" }
                      }
                    }
                  },
                  "stations": {
                    "type": "array",
                    "maxItems": 40,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["guid", "visitCount", "medianAbsAmount", "lastAmount"],
                      "properties": {
                        "guid": { "type": "integer" },
                        "id": { "type": "string", "minLength": 1, "maxLength": 48 },
                        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
                        "visitCount": { "type": "integer", "minimum": 0 },
                        "medianAbsAmount": { "type": "integer", "minimum": 0 },
                        "lastAmount": { "type": "integer" },
                        "areaId": { "type": "integer" },
                        "intervalMsMedian": { "type": "integer", "minimum": 1 }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "production": {
          "type": "array",
          "maxItems": 120,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["guid", "name", "observedAt"],
            "properties": {
              "guid": { "type": "integer" },
              "id": { "type": "string", "minLength": 1, "maxLength": 48 },
              "name": { "type": "string", "minLength": 1, "maxLength": 80 },
              "observedAt": { "type": "string", "format": "date-time" },
              "islandName": { "type": "string", "minLength": 1, "maxLength": 200 },
              "amount": { "type": "number", "minimum": 0 },
              "requiredTMin": { "type": "number", "minimum": 0 },
              "productivity": { "type": "number", "minimum": 0 },
              "buildingCount": { "type": "number", "minimum": 0 },
              "buildingCountObservedAt": { "type": "string", "format": "date-time" },
              "islandRef": { "$ref": "#/$defs/islandRef" }
            }
          }
        },
        "fleet": {
          "type": "array",
          "maxItems": 80,
          "items": { "$ref": "#/$defs/fleetShip" }
        }
      }
    }
  },
  "$defs": {
    "questProgress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current", "required"],
      "properties": {
        "current": { "type": "integer", "minimum": 0 },
        "required": { "type": "integer", "minimum": 0 }
      }
    },
    "questTimer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["remainingMs"],
      "properties": {
        "remainingMs": { "type": "integer", "minimum": 0 },
        "observedAt": { "type": "string", "format": "date-time" }
      }
    },
    "questObjective": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 48 },
        "text": { "type": "string", "minLength": 1, "maxLength": 200 },
        "current": { "type": "integer", "minimum": 0 },
        "required": { "type": "integer", "minimum": 0 },
        "goodId": { "type": "string", "minLength": 1, "maxLength": 48 },
        "goodName": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "namedHits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 48 },
          "name": { "type": "string", "minLength": 1, "maxLength": 80 }
        }
      }
    },
    "buildingHits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 48 },
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "count": { "type": "integer", "exclusiveMinimum": 0 }
        }
      }
    },
    "islandRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["regionId", "areaId"],
      "properties": {
        "regionId": { "type": "integer" },
        "areaId": { "type": "integer" }
      }
    },
    "fleetShip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ownerId", "coverage"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "guid": { "type": "integer", "exclusiveMinimum": 0 },
        "id": { "type": "string", "minLength": 1, "maxLength": 48 },
        "typeName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "kind": { "type": "string", "enum": ["trade", "military", "flagship", "unknown"] },
        "ownerId": { "type": "integer", "const": 0 },
        "metaId": { "type": "integer" },
        "assignment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "type": "string", "enum": ["trade-route", "unknown"] },
            "routeId": { "type": "integer" },
            "routeName": { "type": "string", "minLength": 1, "maxLength": 120 }
          }
        },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "regionId": { "type": "integer" },
            "areaId": { "type": "integer" },
            "name": { "type": "string", "minLength": 1, "maxLength": 200 }
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["identity"],
          "properties": {
            "identity": { "$ref": "#/$defs/fieldCoverage" },
            "type": { "$ref": "#/$defs/fieldCoverage" },
            "assignment": { "$ref": "#/$defs/fieldCoverage" },
            "location": { "$ref": "#/$defs/fieldCoverage" }
          }
        }
      }
    },
    "economy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["treasury", "coverage"],
      "properties": {
        "treasury": { "type": "integer" },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["treasury"],
          "properties": {
            "treasury": { "$ref": "#/$defs/fieldCoverage" }
          }
        }
      }
    },
    "reader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "engine", "capabilities"],
      "properties": {
        "id": { "const": "harbor-watcher" },
        "version": { "type": "string", "minLength": 1, "maxLength": 20 },
        "engine": { "const": "a7s-scan" },
        "capabilities": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "type": "string",
            "enum": [
              "buildings",
              "playerGoods",
              "playerTreasury",
              "routes",
              "routeStations",
              "islandSnapshots",
              "islandNames",
              "islandStock",
              "islandBuildings",
              "fleet"
            ]
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {
        "observedAt": { "type": "string", "format": "date-time" },
        "fields": {
          "type": "array",
          "maxItems": 24,
          "items": { "$ref": "#/$defs/coverageRow" }
        }
      }
    },
    "coverageRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "status"],
      "properties": {
        "field": {
          "type": "string",
          "enum": [
            "buildings",
            "playerGoods",
            "playerTreasury",
            "routes",
            "routeStations",
            "islandSnapshots",
            "islandNames",
            "islandStock",
            "islandBuildings",
            "fleet",
            "quests",
            "income",
            "maintenance",
            "ocrProduction"
          ]
        },
        "status": { "type": "string", "enum": ["present", "absent", "unavailable"] },
        "count": { "type": "integer", "exclusiveMinimum": 0 },
        "reason": {
          "type": "string",
          "enum": [
            "empty-on-purpose",
            "no-player-owner",
            "no-area-id",
            "no-city-name",
            "not-extracted",
            "no-observation"
          ]
        }
      }
    },
    "fieldCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": { "type": "string", "enum": ["save", "ocr", "manual"] },
        "observedAt": { "type": "string", "format": "date-time" },
        "scope": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "islandSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["regionId", "areaId", "ownerId", "name", "nameSource", "coverage"],
      "properties": {
        "regionId": { "type": "integer" },
        "areaId": { "type": "integer" },
        "ownerId": { "type": "integer" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "nameSource": { "type": "string", "enum": ["city-name", "city-name-guid", "neutral"] },
        "stock": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "amount"],
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 48 },
              "name": { "type": "string", "minLength": 1, "maxLength": 80 },
              "amount": { "type": "integer" }
            }
          }
        },
        "buildings": { "$ref": "#/$defs/buildingHits" },
        "population": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "farmers": { "type": "integer", "minimum": 0 },
            "workers": { "type": "integer", "minimum": 0 },
            "artisans": { "type": "integer", "minimum": 0 },
            "engineers": { "type": "integer", "minimum": 0 }
          }
        },
        "capacities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "warehouse": { "type": "integer", "minimum": 0 }
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["identity"],
          "properties": {
            "identity": { "$ref": "#/$defs/fieldCoverage" },
            "stock": { "$ref": "#/$defs/fieldCoverage" },
            "buildings": { "$ref": "#/$defs/fieldCoverage" },
            "population": { "$ref": "#/$defs/fieldCoverage" },
            "capacities": { "$ref": "#/$defs/fieldCoverage" }
          }
        }
      }
    }
  }
}
