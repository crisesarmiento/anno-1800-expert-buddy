{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anno-1800-expert-buddy.local/docs/p0-hud-advisor.schema.json",
  "title": "P0 HUD advisor",
  "description": "One Anno 1800 HUD screenshot → pulse + Spanish next-step. See docs/p0-hud-advisor-contract.md.",
  "$defs": {
    "hudPulse": {
      "type": "string",
      "enum": ["rojo", "amarillo", "vacío", "recado"]
    },
    "hudErrorCode": {
      "type": "string",
      "enum": [
        "empty_paste",
        "multi_image",
        "not_image",
        "not_anno",
        "unreadable_hud",
        "advisor_down"
      ]
    },
    "sentence": {
      "type": "string",
      "minLength": 1,
      "maxLength": 280
    },
    "imageDataUrl": {
      "type": "string",
      "pattern": "^data:image/(png|jpeg|webp);base64,"
    },
    "requestJson": {
      "type": "object",
      "additionalProperties": false,
      "required": ["imageDataUrl"],
      "properties": {
        "imageDataUrl": { "$ref": "#/$defs/imageDataUrl" }
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "pulse", "sentences"],
      "properties": {
        "ok": { "const": true },
        "pulse": { "$ref": "#/$defs/hudPulse" },
        "sentences": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/sentence" }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "code", "message"],
      "properties": {
        "ok": { "const": false },
        "code": { "$ref": "#/$defs/hudErrorCode" },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/success" },
    { "$ref": "#/$defs/error" }
  ]
}
